# Optional. Lets /api/occupy skip the Normies API's per-IP rate limit.
# Set it in your host's environment settings (e.g. Vercel → Project → Settings → Environment
# Variables). Never commit the real value.
NORMIES_INTERNAL_SECRET=

# Set by Vercel when Upstash Redis is added under Storage. Shares the live painting between screens.
KV_REST_API_URL=
KV_REST_API_TOKEN=
